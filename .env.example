# Copy to .env (or set these in your host's dashboard). Only ADMIN_* are needed for first boot.
PORT=3000
NODE_ENV=production

# SQLite file. On Render/Railway/Fly point this at a persistent disk, e.g. /data/arzon.db
DB_FILE=./data/arzon.db

# First admin, created automatically on first boot if no admin exists. Change the password after signing in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-long-password

# Random string used to hash visitor IPs (we never store raw IPs)
IP_SALT=replace-with-a-random-string

# Optional: POST a JSON message for every new submission (Slack/Discord webhook, Zapier, Make, Apps Script…)
NOTIFY_WEBHOOK_URL=

# Optional tuning
# SUBMIT_RATE_LIMIT=20      # form posts per IP per 10 minutes
# TRUST_PROXY=1             # set when behind a reverse proxy / load balancer (default in production)
# SECURE_COOKIES=true       # default true in production (requires HTTPS)
