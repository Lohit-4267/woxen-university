# Copy to .env for local development (or set these in your host's dashboard).

# Postgres connection string. On Supabase use the *connection pooler* URL (port 6543, transaction mode).
# Leave empty for local development: an embedded Postgres (PGlite) is stored in ./data/pglite.
DATABASE_URL=

# First admin, created automatically on first boot if no admin exists. Change the password after signing in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-long-password

# Random string used to hash visitor IPs (raw IPs are never stored)
IP_SALT=replace-with-a-random-string

# Optional: POST a JSON message for every new submission (Slack/Discord webhook, Zapier, Make, Apps Script…)
NOTIFY_WEBHOOK_URL=

# Optional tuning
# PORT=3000
# SUBMIT_RATE_LIMIT=20      # form posts per IP per 10 minutes
# PG_POOL_MAX=3             # connections per server instance
# TRUST_PROXY=1             # default in production
# SECURE_COOKIES=true       # default in production (requires HTTPS)
